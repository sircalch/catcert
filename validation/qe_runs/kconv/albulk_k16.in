&control
  calculation = 'scf'
  prefix = 'albulk_k16'
  pseudo_dir = '/home/andres/pseudo/SSSP_1.3.0_PBE_efficiency'
  outdir = './tmp_kconv_16'
/
&system
  ibrav = 2
  celldm(1) = 7.63449354
  nat = 1
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&electrons
  conv_thr = 1.0d-9
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Al 26.9815 Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Al 0.0 0.0 0.0
K_POINTS automatic
  16 16 16 0 0 0
